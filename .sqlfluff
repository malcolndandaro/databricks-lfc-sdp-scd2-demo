# sqlfluff config for the Direct-Sales E2E demo.
#
# Used by:
# - .github/workflows/pr-validate.yml (sql-lint job)
# - Local pre-commit / manual lint runs
#
# Rule selections target Databricks SDP idioms:
#   - SELECT * is intentional in bronze (1:1 ingest); silver does the projection
#   - read_files() / cloud_files() take string-keyword args sqlfluff doesn't know
#   - _metadata.* virtual columns are Databricks-native, not in the FROM clause
#   - SDP variable substitution like ${source_volume_path} appears as a string
#     literal at lint time

[sqlfluff]
dialect = databricks
templater = raw
max_line_length = 100

# Disabled rules:
#   AM04 — SELECT * in bronze is the desired behaviour
#   RF01 — _metadata virtual columns aren't in the FROM clause
#   CP02 — `addNewColumns` etc. are kwarg/enum values, not identifiers
exclude_rules = AM04, RF01, CP02

[sqlfluff:indentation]
tab_space_size = 2
indented_joins = false
indented_using_on = true

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower
